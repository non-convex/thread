{
  "name": "thread",
  "version": "0.1.0",
  "private": true,
  "description": "A coding-agent runtime with a persistent project Session Tree and turn-level workspace rewind.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/non-convex/thread.git"
  },
  "bugs": {
    "url": "https://github.com/non-convex/thread/issues"
  },
  "homepage": "https://github.com/non-convex/thread#readme",
  "type": "module",
  "bin": {
    "thread": "dist/thread.js"
  },
  "exports": {
    ".": {
      "types": "./dist/types/src/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "bun run scripts/build.ts && tsc -p tsconfig.declarations.json",
    "build:standalone": "bun run scripts/build-standalone.ts",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "bun test test --timeout 30000",
    "test:recall": "bun scripts/verify-recall.ts",
    "test:standalone-recall": "bun scripts/smoke-recall-standalone.ts",
    "start": "bun dist/thread.js",
    "dev": "bun src/cli/main.ts"
  },
  "engines": {
    "bun": ">=1.3.14"
  },
  "packageManager": "bun@1.3.14",
  "dependencies": {
    "@earendil-works/pi-ai": "^0.84.2",
    "@huggingface/tokenizers": "0.1.3",
    "@opentui/core": "0.5.7",
    "@opentui/solid": "0.5.7",
    "@zvec/zvec": "0.7.1",
    "htmlparser2": "^8.0.2",
    "onnxruntime-node": "1.24.3",
    "solid-js": "1.9.12",
    "turndown": "^7.2.0"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@types/node": "24.3.0",
    "@types/turndown": "^5.0.5",
    "typescript": "5.9.2"
  }
}
