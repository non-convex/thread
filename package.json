{
  "name": "thread",
  "version": "0.1.0",
  "private": true,
  "description": "A project-lifetime coding-agent harness with versioned workspace and context branches.",
  "type": "module",
  "bin": {
    "thread": "dist/src/cli/main.js"
  },
  "exports": {
    ".": "./dist/src/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/test/**/*.test.js",
    "test:phase0": "npm run build && node --test dist/test/phase0/**/*.test.js",
    "start": "node dist/src/cli/main.js",
    "dev": "tsx src/cli/main.ts"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "^0.84.2",
    "@earendil-works/pi-tui": "^0.84.2",
    "htmlparser2": "^8.0.2",
    "turndown": "^7.2.0"
  },
  "devDependencies": {
    "@types/node": "24.3.0",
    "@types/turndown": "^5.0.5",
    "tsx": "4.20.5",
    "typescript": "5.9.2"
  }
}
